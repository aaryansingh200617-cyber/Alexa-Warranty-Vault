# Copy to .env (project root). Leave the LLM_* lines empty to use the built-in
# offline assistant: no API key required.

# ---- MCP server ----
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Required if you bind a non-local MCP_HOST. Also used by the agent API as the bearer token.
MCP_AUTH_TOKEN=
EXPIRING_SOON_DAYS=30

# ---- Agent API ----
MCP_URL=http://127.0.0.1:8765/mcp
API_PORT=8000
DEFAULT_CURRENCY=USD

# ---- Language model (any OpenAI-compatible endpoint; pick ONE block) ----
# Option A: Groq (free tier)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_key
# LLM_MODEL=llama-3.3-70b-versatile
#
# Option B: Google Gemini (free tier via Google AI Studio)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your_gemini_key
# LLM_MODEL=gemini-2.5-flash
#
# Option C: OpenRouter (models ending in ":free")
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Option D: Ollama on your own machine (no key, fully free, works offline)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1
